# =============================================================================
# Crypto Report — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in your keys.
# `.env` is gitignored. Never commit real keys.

# -----------------------------------------------------------------------------
# LLM / Search APIs
# -----------------------------------------------------------------------------

# OpenAI — REQUIRED for ranking and report generation
OPENAI_API_KEY=your_openai_key_here

# SerpAPI — for Google news search. If unset, search phase falls back to cached results in data/search_results/
SERP_API_KEY=

# Google Gemini — optional, used as a ranker. If unset, ranker uses keyword scoring only.
GEMINI_API_KEY=

# Firecrawl — optional, used as primary scraper. If unset, falls back to custom site crawlers.
FIRECRAWL_API_KEY=

# CoinAPI — optional, injects price/market metadata into the graph.
COINAPI_KEY=

# -----------------------------------------------------------------------------
# Neo4j — REQUIRED for graph building and report generation
# -----------------------------------------------------------------------------
# Defaults match the docker-compose.yml in this repo.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=cryptoreport

# -----------------------------------------------------------------------------
# Web interface
# -----------------------------------------------------------------------------
FLASK_PORT=5001
